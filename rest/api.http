@baseUrl = http://localhost:8000

### 1. Ping Server
GET {{baseUrl}}/v1/api/ping HTTP/1.1

### 2. Login
POST {{baseUrl}}/v1/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "admin",
  "password": "123456aA@1"
}


### 3. Get All Auth Actions
GET {{baseUrl}}/v1/api/auth/actions HTTP/1.1

### 4. Get All Resources
GET {{baseUrl}}/v1/api/auth/resources HTTP/1.1

### 5. Get Policies (Pagination & Search)
GET {{baseUrl}}/v1/api/auth/policies?page=1&limit=10&search= HTTP/1.1

### 6. Create policy
POST {{baseUrl}}/v1/api/auth/policies HTTP/1.1
Content-Type: application/json

{
  "name": "Policy Name 1",
  "description": "Mô tả chính sách",
  "action_id": 1,
  "resource_id": 1
}

### 7. Get Permissions (Pagination & Search)
GET {{baseUrl}}/v1/api/auth/permissions?limit=10&offset=0&search= HTTP/1.1

### 8. Get Permission by ID
GET {{baseUrl}}/v1/api/auth/permissions/1 HTTP/1.1

### 9. Update Permission by ID
PUT {{baseUrl}}/v1/api/auth/permissions/1 HTTP/1.1
Content-Type: application/json

{
  "name": "ADMIN_FULL_ACCESS_UPDATED",
  "description": "Cập nhật mô tả quyền quản trị",
  "policy_ids": [1]
}

### 10. Delete Permission by ID
DELETE {{baseUrl}}/v1/api/auth/permissions/1 HTTP/1.1

### 11. Create Role
POST {{baseUrl}}/v1/api/auth/roles HTTP/1.1
Content-Type: application/json

{
  "name": "ROLE_MODERATOR",
  "description": "Quản trị viên nội dung và người dùng",
  "is_active": true,
  "permission_ids": [1]
}

### 12. Get Roles (Pagination & Search)
GET {{baseUrl}}/v1/api/auth/roles?page=1&limit=10&search= HTTP/1.1
