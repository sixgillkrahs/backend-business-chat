@baseUrl = http://localhost:8000

### 1. Ping Server
GET {{baseUrl}}/v1/api/ping HTTP/1.1

### 1.1 Register Account (Public / Self-service)
POST {{baseUrl}}/v1/api/auth/register HTTP/1.1
Content-Type: application/json

{
  "username": "newuser01",
  "email": "newuser01@example.com",
  "password": "Password123@!",
  "full_name": "New User Full Name",
  "phone_number": "0912345678",
  "address": "123 Main Street"
}

### 2. Login
POST {{baseUrl}}/v1/api/auth/login HTTP/1.1
Content-Type: application/json

{
  "username": "admin",
  "password": "123456aA@1"
}

### 2.1 Refresh Token (Dual transport: JSON Body or HttpOnly Cookie)
POST {{baseUrl}}/v1/api/auth/refresh-token HTTP/1.1
Content-Type: application/json

{
  "refresh_token": "YOUR_REFRESH_TOKEN_HERE"
}



### 3. Get All Auth Actions
GET {{baseUrl}}/v1/api/auth/actions HTTP/1.1

### 4. Get All Resources
GET {{baseUrl}}/v1/api/auth/resources HTTP/1.1

### 5. Get Policies (Pagination & Search)
GET {{baseUrl}}/v1/api/auth/policies?page=1&limit=10&search= HTTP/1.1

### 6. Create policy
POST {{baseUrl}}/v1/api/auth/policies HTTP/1.1
Content-Type: application/json

{
  "name": "Policy Name 1",
  "description": "Mô tả chính sách",
  "action_id": 1,
  "resource_id": 1
}

### 7. Get Permissions (Pagination & Search)
GET {{baseUrl}}/v1/api/auth/permissions?limit=10&offset=0&search= HTTP/1.1

### 8. Get Permission by ID
GET {{baseUrl}}/v1/api/auth/permissions/1 HTTP/1.1

### 9. Update Permission by ID
PUT {{baseUrl}}/v1/api/auth/permissions/1 HTTP/1.1
Content-Type: application/json

{
  "name": "ADMIN_FULL_ACCESS_UPDATED",
  "description": "Cập nhật mô tả quyền quản trị",
  "policy_ids": [1]
}

### 10. Delete Permission by ID
DELETE {{baseUrl}}/v1/api/auth/permissions/1 HTTP/1.1

### 11. Create Role
POST {{baseUrl}}/v1/api/auth/roles HTTP/1.1
Content-Type: application/json

{
  "name": "ROLE_MODERATOR",
  "description": "Quản trị viên nội dung và người dùng",
  "is_active": true,
  "permission_ids": [1]
}

### 12. Get Roles (Pagination & Search)
GET {{baseUrl}}/v1/api/auth/roles?page=1&limit=10&search= HTTP/1.1

### 13. Update Role by ID
PUT {{baseUrl}}/v1/api/auth/roles/1 HTTP/1.1
Content-Type: application/json

{
  "name": "ROLE_MODERATOR_UPDATED",
  "description": "Quản trị viên diễn đàn cập nhật",
  "is_active": true,
  "permission_ids": [1]
}

### 14. Change Role Status by ID (Set is_active)
PATCH {{baseUrl}}/v1/api/auth/roles/1/status HTTP/1.1
Content-Type: application/json

{
  "is_active": false
}

### 15. Toggle Role Status by ID (Toggle active/inactive without body)
PATCH {{baseUrl}}/v1/api/auth/roles/1/status HTTP/1.1

### 16. Deactivate Role by ID (Legacy shortcut)
PATCH {{baseUrl}}/v1/api/auth/roles/1/deactivate HTTP/1.1

### 17. Delete Role by ID
DELETE {{baseUrl}}/v1/api/auth/roles/1 HTTP/1.1

### 18. Create User
POST {{baseUrl}}/v1/api/auth/users HTTP/1.1
Content-Type: application/json

{
  "username": "johndoe",
  "email": "johndoe@example.com",
  "password": "Password123@",
  "full_name": "John Doe",
  "role_id": 1
}

### 19. Get Users (Pagination & Search)
GET {{baseUrl}}/v1/api/auth/users?limit=10&offset=0&search= HTTP/1.1

### 20. Get User by ID
GET {{baseUrl}}/v1/api/auth/users/1 HTTP/1.1

### 21. Update User by ID
PUT {{baseUrl}}/v1/api/auth/users/1 HTTP/1.1
Content-Type: application/json

{
  "full_name": "John Doe Updated",
  "email": "johndoe_updated@example.com",
  "is_active": true
}

### 22. Delete User by ID
DELETE {{baseUrl}}/v1/api/auth/users/2 HTTP/1.1



